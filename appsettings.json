{
    "WordlessApi":{
        "ApiRootUri": "/api",
        "PathBase": null,
        "WebRootPath": null,
        "ContentRootPath": null
    },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Kestrel":{
     "Endpoints":{
        "Http":{
           "Url":"http://*:5000"
        }
     },
     "Cors": {
          "AllowedMethods": [ "*" ],
          "AllowedHeaders": [ "*" ],
          "AllowCredentials": false
     }
  }
}
